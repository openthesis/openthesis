+static int svm_complete_rdtsc_exit(struct kvm_vcpu *vcpu)
+{
+	u64 tsc = vcpu->run->rdtsc.tsc_value;
+	kvm_rax_write(vcpu, (u32)tsc);
+	kvm_rdx_write(vcpu, tsc >> 32);
+	/* Ensure pending virtio/vsock interrupts are delivered on re-entry */
+	kvm_make_request(KVM_REQ_EVENT, vcpu);
+	return kvm_skip_emulated_instruction(vcpu);
+}
+
+static int svm_handle_rdtsc_exit(struct kvm_vcpu *vcpu)
+{
+	vcpu->run->exit_reason = KVM_EXIT_X86_RDTSC;
+	vcpu->run->rdtsc.tsc_value = 0;
+	vcpu->arch.complete_userspace_io = svm_complete_rdtsc_exit;
+	return 0;
+}
+
+static int svm_handle_rdtscp_exit(struct kvm_vcpu *vcpu)
+{
+	if (vcpu->kvm->arch.rdtsc_exiting)
+		return svm_handle_rdtsc_exit(vcpu);
+	return kvm_handle_invalid_op(vcpu);
+}
