diff --git a/src/vmm/src/devices/virtio/transport/mmio.rs b/src/vmm/src/devices/virtio/transport/mmio.rs
index 1a252c4d..79bf775f 100644
--- a/src/vmm/src/devices/virtio/transport/mmio.rs
+++ b/src/vmm/src/devices/virtio/transport/mmio.rs
@@ -95,6 +95,38 @@ impl MmioTransport {
         self.device.clone()
     }
 
+
+    /// Restore transport and device queue state in-place (DST).
+    pub fn restore_state_in_place(
+        &mut self,
+        transport_state: &crate::devices::virtio::persist::MmioTransportState,
+        virtio_state: &crate::devices::virtio::persist::VirtioDeviceState,
+    ) {
+        use std::num::Wrapping;
+        use crate::vstate::memory::GuestAddress;
+        self.features_select = transport_state.features_select;
+        self.acked_features_select = transport_state.acked_features_select;
+        self.queue_select = transport_state.queue_select;
+        self.device_status = transport_state.device_status;
+        self.config_generation = transport_state.config_generation;
+        self.interrupt.irq_status.store(transport_state.interrupt_status, std::sync::atomic::Ordering::SeqCst);
+        let mut device = self.device.lock().expect("Poisoned lock");
+        let queues = device.queues_mut();
+        for (i, sq) in virtio_state.queues.iter().enumerate() {
+            if i >= queues.len() { break; }
+            let q = &mut queues[i];
+            q.max_size = sq.max_size; q.size = sq.size; q.ready = sq.ready;
+            q.desc_table_address = GuestAddress(sq.desc_table);
+            q.avail_ring_address = GuestAddress(sq.avail_ring);
+            q.used_ring_address = GuestAddress(sq.used_ring);
+            q.next_avail = Wrapping(sq.next_avail.0);
+            q.next_used = Wrapping(sq.next_used.0);
+            q.num_added = Wrapping(sq.num_added.0);
+            if q.ready { let _ = q.initialize(&self.mem); }
+        }
+        device.set_acked_features(virtio_state.acked_features);
+    }
+
     fn check_device_status(&self, set: u32, clr: u32) -> bool {
         self.device_status & (set | clr) == set
     }
