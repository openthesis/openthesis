+        };
+        let mut sched = self.preemption_schedule.lock().unwrap();
+        *sched = intervals;
+        self.preemption_idx.store(0, Ordering::Relaxed);
+        self.next_preemption_ns.store(first_target, Ordering::Relaxed);
+    }
+
+    /// Returns true if the current virtual time has reached the next preemption
+    /// point and advances the schedule index for the next call. Called from the
+    /// vCPU RDTSC exit handler on every clock advance.
+    pub fn check_preemption(&self) -> bool {
+        let now = self.monotonic_ns.load(Ordering::Relaxed);
+        let next = self.next_preemption_ns.load(Ordering::Relaxed);
+        if now < next { return false; }
+        let sched = self.preemption_schedule.lock().unwrap();
+        if sched.is_empty() { return false; }
+        let idx = self.preemption_idx.load(Ordering::Relaxed) as usize;
+        let next_idx = idx + 1;
