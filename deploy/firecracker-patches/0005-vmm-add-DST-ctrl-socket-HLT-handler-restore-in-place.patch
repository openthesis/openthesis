@@ -127,6 +127,40 @@ impl ArchVm {
     /// - [`kvm_ioctls::VmFd::set_irqchip`] errors.
     /// - [`kvm_ioctls::VmFd::set_irqchip`] errors.
     /// - [`kvm_ioctls::VmFd::set_irqchip`] errors.
+    /// Requires custom host kernel with the HLT user exit patch.
+    pub fn enable_rdtsc_exiting(&self) -> Result<(), kvm_ioctls::Error> {
+        // Cap number depends on host kernel version: 236 for 6.8.x, 245 for 6.18+.
+        // OPENTHESIS_KVM_CAP_RDTSC is set by the orchestrator at launch.
+        let cap: u32 = std::env::var("OPENTHESIS_KVM_CAP_RDTSC")
+            .ok().and_then(|s| s.parse().ok()).unwrap_or(236);
+        self.fd().enable_cap(&kvm_bindings::kvm_enable_cap {
+            cap,
+            args: [0; 4],
+            ..Default::default()
+        })
+    }
+
+    pub fn enable_hlt_user_exit(&self) -> Result<(), kvm_ioctls::Error> {
+        // Cap number depends on host kernel version: 237 for 6.8.x, 246 for 6.18+.
+        // OPENTHESIS_KVM_CAP_HLT is set by the orchestrator at launch.
+        let cap: u32 = std::env::var("OPENTHESIS_KVM_CAP_HLT")
+            .ok().and_then(|s| s.parse().ok()).unwrap_or(237);
+        self.fd().enable_cap(&kvm_bindings::kvm_enable_cap {
+            cap,
+            args: [0; 4],
+            ..Default::default()
+        })
+    }
+
+    pub fn disable_halt_polling(&self) -> Result<(), kvm_ioctls::Error> {
+        // KVM_CAP_HALT_POLL = 25
+        self.fd().enable_cap(&kvm_bindings::kvm_enable_cap {
+            cap: 25, // KVM_CAP_HALT_POLL
+            args: [0; 4], // args[0] = 0 disables polling
+            ..Default::default()
+        })
+    }
+
     pub fn restore_state(&mut self, state: &VmState) -> Result<(), ArchVmError> {
         self.fd()
             .set_pit2(&state.pitstate)
