     /// Sends a pause command to the vCPUs.
+    /// Restore VM state in-place without killing the process (DST).
+    pub fn restore_in_place(&mut self, snapshot_path: &str, mem_path: &str) -> Result<i64, VmmError> {
+        use std::path::Path;
+        use crate::devices::virtio::device::VirtioDeviceType;
+
+        let microvm_state = crate::persist::snapshot_state_from_file(Path::new(snapshot_path))
+            .map_err(|e| VmmError::SnapshotRestore(format!("load snapshot: {e}")))?;
+
+        // Restore guest memory from the snapshot mem file.
+        // The file is a raw concatenation of all guest memory regions in iteration order
+        // (same order used by GuestMemoryMmap::dump() during snapshot creation).
+        // Since snapshots live on /dev/shm (tmpfs), this is a memory-to-memory copy.
+        let mem_file = std::fs::File::open(mem_path)
+            .map_err(|e| VmmError::SnapshotRestore(format!("open mem file: {e}")))?;
+        {
+            use std::os::unix::io::AsRawFd;
+            let guest_mem = self.vm.guest_memory();
+            let mut file_offset: i64 = 0;
+            for region in guest_mem.iter() {
+                let ptr = region.as_ptr() as *mut u8;
+                let region_len = region.len() as usize;
+                let mut buf_offset: usize = 0;
+                while buf_offset < region_len {
+                    let n = unsafe {
+                        libc::pread(
+                            mem_file.as_raw_fd(),
+                            ptr.add(buf_offset) as *mut libc::c_void,
+                            region_len - buf_offset,
+                            file_offset + buf_offset as i64,
+                        )
+                    };
+                    if n <= 0 {
+                        return Err(VmmError::SnapshotRestore(format!(
+                            "pread mem file at offset {}: errno {}",
+                            file_offset + buf_offset as i64,
+                            unsafe { *libc::__errno_location() },
+                        )));
+                    }
+                    buf_offset += n as usize;
+                }
+                file_offset += region_len as i64;
+            }
+        }
+
+        // Restore vCPU state.
+        // First ensure the vCPU is cleanly paused — drain any stale responses
+        // from previous run-burst self-pause, then send Pause + wait for Paused.
+        if let Some(vcpu_state) = microvm_state.vcpu_states.first() {
+            let handle = &mut self.vcpus_handles[0];
+            // Drain stale responses (from run-burst self-pause or previous operations)
+            while let Ok(_) = handle.response_receiver().try_recv() {}
+            // Ensure paused state
+            let _ = handle.send_event(VcpuEvent::Pause);
+            match handle.response_receiver().recv_timeout(std::time::Duration::from_secs(2)) {
+                Ok(VcpuResponse::Paused) => {}
+                _ => { log::warn!("DST: vCPU not in paused state for RestoreState"); }
+            }
+            // Now restore
+            handle.send_event(VcpuEvent::RestoreState(Box::new(vcpu_state.clone())))
+                .map_err(|e| VmmError::SnapshotRestore(format!("send restore: {e}")))?;
+            match handle.response_receiver().recv_timeout(std::time::Duration::from_secs(5)) {
+                Ok(VcpuResponse::RestoredState) => {}
+                Ok(VcpuResponse::Error(e)) => return Err(VmmError::SnapshotRestore(format!("vcpu: {e}"))),
+                other => return Err(VmmError::SnapshotRestore(format!("unexpected: {other:?}"))),
+            }
+            // immediate_exit is cleared inside the RestoreState handler on the vCPU
+            // thread (see the VcpuEvent::RestoreState arm in vcpu/mod.rs). The vCPU
+            // is now ready to resume without EINTR on the first KVM_RUN call.
+        }
+
+        // Restore device state (queue indices, transport registers)
+        let ds = &microvm_state.device_states;
+        for saved in &ds.mmio_state.block_devices {
+            let vs = match &saved.device_state {
+                crate::devices::virtio::block::persist::BlockState::Virtio(v) => &v.virtio_state,
+                _ => continue,
+            };
+            if let Some(dev) = self.device_manager.mmio_devices.get_mut_virtio_device(VirtioDeviceType::Block, &saved.device_id) {
+                dev.inner.lock().unwrap().restore_state_in_place(&saved.transport_state, vs);
+            }
+        }
+        for saved in &ds.mmio_state.net_devices {
+            if let Some(dev) = self.device_manager.mmio_devices.get_mut_virtio_device(VirtioDeviceType::Net, &saved.device_id) {
+                dev.inner.lock().unwrap().restore_state_in_place(&saved.transport_state, &saved.device_state.virtio_state);
+            }
+        }
+        if let Some(saved) = &ds.mmio_state.vsock_device {
+            if let Some(dev) = self.device_manager.mmio_devices.get_mut_virtio_device(VirtioDeviceType::Vsock, &saved.device_id) {
+                let mut transport = dev.inner.lock().unwrap();
+                transport.restore_state_in_place(&saved.transport_state, &saved.device_state.frontend.virtio_state);
+                // Reset vsock muxer connections: the guest memory was reset
+                // so the guest has no active connections. The host muxer must match.
+                let mut device = transport.locked_device();
+                if let Some(vsock) = device.as_mut_any().downcast_mut::<Vsock<VsockUnixBackend>>() {
+                    vsock.backend_mut().reset_connections();
+                    log::info!("DST: vsock muxer connections reset for in-place restore");
+                }
+            }
+        }
+        if let Some(saved) = &ds.mmio_state.entropy_device {
+            if let Some(dev) = self.device_manager.mmio_devices.get_mut_virtio_device(VirtioDeviceType::Rng, &saved.device_id) {
+                dev.inner.lock().unwrap().restore_state_in_place(&saved.transport_state, &saved.device_state.virtio_state);
+            }
+        }
+        if let Some(saved) = &ds.mmio_state.balloon_device {
+            if let Some(dev) = self.device_manager.mmio_devices.get_mut_virtio_device(VirtioDeviceType::Balloon, &saved.device_id) {
+                dev.inner.lock().unwrap().restore_state_in_place(&saved.transport_state, &saved.device_state.virtio_state);
+            }
+        }
+
+        Ok(0)
+    }
