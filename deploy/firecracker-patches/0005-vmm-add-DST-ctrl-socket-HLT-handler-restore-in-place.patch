+        };
+        self.preemption_idx.store(next_idx as u64, Ordering::Relaxed);
+        self.next_preemption_ns.store(next_target, Ordering::Relaxed);
+        true
+    }
+
+    pub fn clear_preemption_schedule(&self) {
+        let mut sched = self.preemption_schedule.lock().unwrap();
+        sched.clear();
+        self.next_preemption_ns.store(i64::MAX, Ordering::Relaxed);
+    }
