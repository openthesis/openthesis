     /// Return the file system path of the host-side Unix socket.
+    /// Reset all active connections for in-place snapshot restore (DST).
+    /// Clears host-side muxer state to match the restored guest memory state.
+    /// The host_sock UDS listener stays open for new connections.
+    pub fn reset_connections(&mut self) {
+        let keys: Vec<ConnMapKey> = self.conn_map.keys().cloned().collect();
+        for key in keys {
+            self.remove_connection(key);
+        }
+        self.local_port_set.clear();
+        self.local_port_last = (1u32 << 30) - 1;
+        self.rxq = MuxerRxQ::new();
+        self.killq = MuxerKillQ::new();
+    }
+
