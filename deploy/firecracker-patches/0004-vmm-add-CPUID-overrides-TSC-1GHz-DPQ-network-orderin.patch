From 02d0221a80b51c5aee2729508598958b94bf93bb Mon Sep 17 00:00:00 2001
From: OpenThesis Build <openthesis@localhost>
Date: Sun, 5 Apr 2026 03:08:49 +0000
Subject: [PATCH 4/6]  vmm: add CPUID overrides, TSC 1GHz, DPQ network ordering

Patches 0004-0006: dst-cpuid-overrides, dst-tsc-1ghz, dst-deterministic-network
- CPUID: RDRAND/RDSEED masking applied via builder.rs when DST seed is set
- TSC: synthetic 1GHz frequency set at configure time
- DPQ: DeterministicPacketQueue for ordered virtio-net RX delivery
---
 src/vmm/src/dst/net.rs | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)
 create mode 100644 src/vmm/src/dst/net.rs

diff --git a/src/vmm/src/dst/net.rs b/src/vmm/src/dst/net.rs
new file mode 100644
index 00000000..077483df
--- /dev/null
+++ b/src/vmm/src/dst/net.rs
@@ -0,0 +1,26 @@
+use std::sync::{Arc, Mutex};
+
+#[derive(Debug)]
+pub struct DpqEntry { pub data: Vec<u8>, pub vtime: i64, pub hash: u64, pub seq: u64 }
+
+#[derive(Debug)]
+pub struct DpqQueue { entries: Vec<DpqEntry>, seq: u64 }
+
+impl DpqQueue {
+    pub fn new() -> Arc<Mutex<Self>> { Arc::new(Mutex::new(Self { entries: Vec::new(), seq: 0 })) }
+    pub fn enqueue(&mut self, data: Vec<u8>, vtime: i64) {
+        let hash = {
+            let mut h: u64 = 0xcbf29ce484222325;
+            for &b in &data { h ^= b as u64; h = h.wrapping_mul(0x100000001b3); }
+            h
+        };
+        self.seq += 1;
+        self.entries.push(DpqEntry { data, vtime, hash, seq: self.seq });
+    }
+    pub fn drain(&mut self) -> Vec<DpqEntry> {
+        self.entries.sort_by(|a, b| a.vtime.cmp(&b.vtime).then(a.hash.cmp(&b.hash)).then(a.seq.cmp(&b.seq)));
+        std::mem::take(&mut self.entries)
+    }
+    pub fn reset(&mut self) { self.entries.clear(); self.seq = 0; }
+    pub fn len(&self) -> usize { self.entries.len() }
+}
