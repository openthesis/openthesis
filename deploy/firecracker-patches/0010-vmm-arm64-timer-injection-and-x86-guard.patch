 pub mod rdtsc;
+
+#[cfg(target_arch = "aarch64")]
+pub mod arm_timer;
diff --git a/src/vmm/src/vstate/vcpu.rs b/src/vmm/src/vstate/vcpu.rs
index 91db8baa9..c1f2d8403 100644
--- a/src/vmm/src/vstate/vcpu.rs
+++ b/src/vmm/src/vstate/vcpu.rs
@@ -511,11 +511,22 @@ impl Vcpu {
                         }
                     }

-                        // Boot phase (no burst target): inject raw host rdtsc as the guest TSC.
-                        // KVM default tsc_offset=0 means guest_tsc == host_tsc.
-                        // Injecting host_tsc directly keeps ktime_get() and LAPIC deadlines correct.
-                        let host_tsc = unsafe { core::arch::x86_64::_rdtsc() };
-                        crate::dst::rdtsc::set_rdtsc_response(&mut self.kvm_vcpu.fd, host_tsc);
-                        return Ok(VcpuEmulation::Handled);
+                        // Boot phase (no burst target): inject host timer as the guest time reference.
+                        // x86_64: raw host RDTSC (KVM tsc_offset=0 makes guest_tsc == host_tsc).
+                        // aarch64: CNTVOFF_EL2 = -CNTPCT_EL0 so CNTVCT_EL0 starts at 0.
+                        #[cfg(target_arch = "x86_64")]
+                        {
+                            let host_tsc = unsafe { core::arch::x86_64::_rdtsc() };
+                            crate::dst::rdtsc::set_rdtsc_response(&mut self.kvm_vcpu.fd, host_tsc);
+                            return Ok(VcpuEmulation::Handled);
+                        }
+                        #[cfg(target_arch = "aarch64")]
+                        {
+                            if let Err(e) = crate::dst::arm_timer::set_virtual_timer(
+                                &mut self.kvm_vcpu.fd,
+                                0,
+                            ) {
+                                log::warn!("DST: arm64 boot-phase timer inject failed: {}", e);
+                            }
+                            return Ok(VcpuEmulation::Handled);
+                        }
                     }
                 }
                 handle_kvm_exit(&mut self.kvm_vcpu.peripherals, emulation_result)
