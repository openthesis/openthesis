 		return nil, fmt.Errorf("enabling strace: %w", err)
@@ -2179,3 +2179,33 @@ func (l *Loader) GetContainerSpecs() map[string]*specs.Spec {
 	defer l.mu.Unlock()
 	return l.containerSpecs
 }
+
+// newDSTClocks returns a VirtualClock wrapped as the Clocks interface when
+// DST mode is enabled, otherwise returns a new CalibratedClocks. This is
+// called from Loader.New in place of sentryTime.NewCalibratedClocks().
+func newDSTClocks(conf *config.Config) (sentryTime.Clocks, *sentryTime.VirtualClock) {
+	if !conf.DSTEnabled {
+		return sentryTime.NewCalibratedClocks(), nil
+	}
+
+	opts := sentryTime.DefaultVirtualClockOpts()
+	if conf.DSTEpoch > 0 {
+		opts.Epoch = gtime.Unix(0, conf.DSTEpoch)
+	}
+	if conf.DSTQuantumNS > 0 {
+		opts.QuantumNS = conf.DSTQuantumNS
+	}
+
+	vc := sentryTime.NewVirtualClock(opts)
+	return vc, vc
+}
+
+// initDSTControlSocket creates and starts the OpenThesis control socket
+// if the --openthesis-control flag was provided.
+func (l *Loader) initDSTControlSocket(socketPath string) error {
+	if socketPath == "" {
+		return nil
+	}
+	// NOTE: Control socket server initialization is handled in patch 07.
+	return nil
+}
