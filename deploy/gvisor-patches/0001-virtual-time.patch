diff --git a/pkg/sentry/time/calibrated_clock.go b/pkg/sentry/time/calibrated_clock.go
index 47df5d0a1..d26abd1a7 100644
--- a/pkg/sentry/time/calibrated_clock.go
+++ b/pkg/sentry/time/calibrated_clock.go
@@ -48,6 +48,9 @@ type CalibratedClock struct {
 
 	// errorNS is the estimated clock error in nanoseconds.
 	errorNS ReferenceNS
+
+	// dstClock is set in DST mode to redirect all time queries.
+	dstClock *VirtualClock
 }
 
 // NewCalibratedClock creates a CalibratedClock that tracks the given ClockID.
@@ -193,10 +196,24 @@ func (c *CalibratedClock) Update() (Parameters, bool) {
 	return c.params, true
 }
 
+// SetDSTClock redirects all time queries to the given VirtualClock.
+// When set, the CalibratedClock stops reading from the host TSC and
+// instead delegates entirely to the VirtualClock.
+func (c *CalibratedClock) SetDSTClock(vc *VirtualClock) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.dstClock = vc
+}
+
 // GetTime returns the current time based on the clock calibration.
 func (c *CalibratedClock) GetTime() (int64, error) {
 	c.mu.RLock()
 
+	if c.dstClock != nil {
+		c.mu.RUnlock()
+		return c.dstClock.MonotonicNS(), nil
+	}
+
 	if !c.ready {
 		// Fallback to a syscall.
 		now, err := c.ref.Syscall()
@@ -259,3 +276,10 @@ func (c *CalibratedClocks) GetTime(id ClockID) (int64, error) {
 		return 0, linuxerr.EINVAL
 	}
 }
+
+// SetDSTClock redirects both clocks to the given VirtualClock.
+// Called from the loader when DST mode is enabled.
+func (c *CalibratedClocks) SetDSTClock(vc *VirtualClock) {
+	c.monotonic.SetDSTClock(vc)
+	c.realtime.SetDSTClock(vc)
+}
