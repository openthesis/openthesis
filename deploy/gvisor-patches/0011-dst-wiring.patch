+package kernel
+
+import (
+	sentrytime "gvisor.dev/gvisor/pkg/sentry/time"
+)
+
+// InitDST wires all deterministic simulation testing components into the
+// kernel. Must be called from the boot loader after kernel.Init() completes
+// and before the first container task is created. All parameters must be
+// non-nil. InitDST starts the deterministic scheduler goroutine.
+func (k *Kernel) InitDST(
+	vc *sentrytime.VirtualClock,
+	rng *DeterministicRNG,
+	sched *DeterministicScheduler,
+	st *SnapshotTree,
+	sft *SyscallFaultTable,
+) {
+	k.dstEnabled = true
+	// *VirtualClock implements sentrytime.Clocks; store via the interface so
+	// callers outside the kernel package do not need the concrete type.
+	k.dstVirtualClock = vc
+	k.dstRNG = rng
+	k.dstScheduler = sched
+	k.dstSnapshotTree = st
+	k.dstSyscallFaultTable = sft
+
+	// Start the scheduler loop in the background. It blocks until tasks become
+	// runnable, so starting it before container creation is harmless.
+	go sched.Schedule()
+}
diff --git a/runsc/boot/loader.go b/runsc/boot/loader.go
index d8f45931c..dec663b07 100644
--- a/runsc/boot/loader.go
+++ b/runsc/boot/loader.go
@@ -615,7 +615,21 @@ func New(args Args) (*Loader, error) {
 	// Create timekeeper.
 	tk := kernel.NewTimekeeper()
 	params := kernel.NewVDSOParamPage(l.k.MemoryFile(), vdso.ParamPage.FileRange())
-	tk.SetClocks(sentryTime.NewCalibratedClocks(), params)
+	dstClocks, dstVC := newDSTClocks(args.Conf)
+	tk.SetClocks(dstClocks, params)
+
+	// When DST mode is requested, wire all deterministic components into the
+	// kernel and start the OpenThesis control socket before any tasks run.
+	if dstVC != nil {
+		rng := kernel.NewDeterministicRNG(0)
+		sched := kernel.NewDeterministicScheduler(dstVC, uint64(args.Conf.DSTQuantumNS))
+		st := kernel.NewSnapshotTree()
+		sft := kernel.NewSyscallFaultTable(rng)
+		l.k.InitDST(dstVC, rng, sched, st, sft)
+		if err := l.initDSTControlSocket(args.Conf.DSTControlPath); err != nil {
+			return nil, fmt.Errorf("dst control socket: %w", err)
+		}
+	}
 
 	if err := enableStrace(args.Conf); err != nil {
 		return nil, fmt.Errorf("enabling strace: %w", err)
