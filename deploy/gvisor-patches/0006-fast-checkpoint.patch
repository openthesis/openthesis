+package boot
+
+const (
+	// DSTCheckpoint is the urpc method to take a DST snapshot.
+	DSTCheckpoint = "DSTManager.Checkpoint"
+	// DSTRestore is the urpc method to restore a DST snapshot.
+	DSTRestore = "DSTManager.Restore"
+)
+
+// DSTCheckpointArgs are the arguments to DSTManager.Checkpoint.
+type DSTCheckpointArgs struct {
+	SnapshotID string
+}
+
+// DSTCheckpointResult is the result of DSTManager.Checkpoint.
+type DSTCheckpointResult struct {
+	SnapshotID    string
+	VirtualTimeNS int64
+	RNGSeed       uint64
+}
+
+// DSTRestoreArgs are the arguments to DSTManager.Restore.
+type DSTRestoreArgs struct {
+	SnapshotID string
+}
+
+// DSTRestoreResult is the result of DSTManager.Restore.
+// It contains the DST metadata needed for the control plane to
+// restart the container with the same deterministic parameters.
+type DSTRestoreResult struct {
+	SnapshotID    string
+	VirtualTimeNS int64
+	RNGSeed       uint64
+}
diff --git a/runsc/sandbox/sandbox.go b/runsc/sandbox/sandbox.go
index 0dc4e235c..81519cb9d 100644
--- a/runsc/sandbox/sandbox.go
+++ b/runsc/sandbox/sandbox.go
@@ -2151,3 +2151,38 @@ func SetCloExeOnAllFDs() (retErr error) {
 	setCloseExecOnce.Do(func() { retErr = setCloExeOnAllFDs() })
 	return
 }
+
+// DSTCheckpoint creates a named snapshot of the sandbox DST state.
+// The snapshotID is an opaque string used to reference this snapshot
+// in future DSTRestore calls.
+func (s *Sandbox) DSTCheckpoint(snapshotID string) error {
+	log.Infof("DSTCheckpoint: taking snapshot %q for sandbox %q", snapshotID, s.ID)
+	conn, err := s.sandboxConnect()
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	return conn.Call(boot.DSTCheckpoint, &boot.DSTCheckpointArgs{
+		SnapshotID: snapshotID,
+	}, nil)
+}
+
+// DSTRestore retrieves the DST metadata for a previously taken snapshot.
+// The caller is responsible for container restart and deterministic replay.
+func (s *Sandbox) DSTRestore(snapshotID string) (*boot.DSTRestoreResult, error) {
+	log.Infof("DSTRestore: fetching snapshot %q for sandbox %q", snapshotID, s.ID)
+	conn, err := s.sandboxConnect()
+	if err != nil {
+		return nil, err
+	}
+	defer conn.Close()
+	var result boot.DSTRestoreResult
+	if err := conn.Call(boot.DSTRestore, &boot.DSTRestoreArgs{
+		SnapshotID: snapshotID,
+	}, &result); err != nil {
+		return nil, err
+	}
+	return &result, nil
+}
+
+// DSTState returns the current DST sandbox state (running, paused, stopped).
