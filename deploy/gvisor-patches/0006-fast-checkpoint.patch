+
+package kernel
+
+import (
+	"fmt"
+	"sync"
+	"time"
+
+	sentrytime "gvisor.dev/gvisor/pkg/sentry/time"
+)
+
+// SnapshotState is the serialized DST metadata captured at a checkpoint.
+// It does NOT include guest application memory; the control plane is
+// responsible for container restart + deterministic replay on restore.
+type SnapshotState struct {
+	// ID is the unique snapshot identifier assigned by the control plane.
+	ID string
+
+	// VirtualTimeNS is the virtual clock value at snapshot time.
+	VirtualTimeNS int64
+
+	// RNGSeed is the current RNG seed at snapshot time.
+	RNGSeed uint64
+
+	// ParentID is the ID of the parent snapshot (empty for root).
+	ParentID string
+
+	// Created is the wall-clock time the snapshot was taken (bookkeeping only).
+	Created time.Time
+
+	// Depth is the number of snapshots from the root.
+	Depth int
+}
+
+// SnapshotTree manages a tree of serialized DST state snapshots.
+// Each snapshot stores the DST metadata (virtual time, RNG seed) needed
+// to deterministically replay the system from that point.
+//
+// Unlike sfork-based snapshots, this approach does not fork the sentry
+// process, making it compatible with gVisor's seccomp constraints.
+// Restoring a snapshot requires restarting the container with the saved
+// DST parameters — the control plane (gvisor.go) handles this.
+type SnapshotTree struct {
+	mu        sync.Mutex
+	snapshots map[string]*SnapshotState
+	current   string
+}
+
+// NewSnapshotTree creates a new snapshot tree.
+func NewSnapshotTree() *SnapshotTree {
+	return &SnapshotTree{
+		snapshots: make(map[string]*SnapshotState),
+	}
+}
+
+// Take captures the current DST state as a named snapshot.
+//
+// The sequence is:
+//  1. Pause the deterministic scheduler and freeze the virtual clock.
+//  2. Serialize the DST state (virtual time NS, RNG seed).
+//  3. Resume the scheduler.
+//
+// No fork is performed. The returned SnapshotState contains all metadata
+// the control plane needs to restore deterministic execution.
+func (st *SnapshotTree) Take(k *Kernel, id string) (*SnapshotState, error) {
+	// 1. Pause scheduler and clock.
+	if k.dstScheduler != nil {
+		k.dstScheduler.Pause()
+		defer k.dstScheduler.Resume()
+	}
+
+	// 2. Collect DST metadata.
+	var vt int64
+	if k.dstVirtualClock != nil {
+		vt, _ = k.dstVirtualClock.GetTime(sentrytime.Monotonic)
+	}
+
+	var seed uint64
+	if k.dstRNG != nil {
+		seed = k.dstRNG.Seed()
+	}
+
+	st.mu.Lock()
+	parentDepth := 0
+	if parent, ok := st.snapshots[st.current]; ok {
+		parentDepth = parent.Depth
+	}
+
+	snap := &SnapshotState{
+		ID:            id,
+		VirtualTimeNS: vt,
+		RNGSeed:       seed,
+		ParentID:      st.current,
+		Created:       time.Now(),
+		Depth:         parentDepth + 1,
+	}
+	st.snapshots[id] = snap
+	st.current = id
+	st.mu.Unlock()
+
+	return snap, nil
+}
+
+// Restore retrieves the saved DST state for a snapshot. The caller
+// (control plane) is responsible for:
+//   - Stopping the current container.
+//   - Starting a new container.
+//   - Applying snap.VirtualTimeNS via set-time and snap.RNGSeed via set-seed.
+//
+// Restore does NOT terminate the sentry or fork. It simply returns the
+// metadata needed for the control plane to reconstruct the state.
+func (st *SnapshotTree) Restore(id string) (*SnapshotState, error) {
+	st.mu.Lock()
+	snap, ok := st.snapshots[id]
+	st.mu.Unlock()
+	if !ok {
+		return nil, fmt.Errorf("snapshot %q not found", id)
+	}
+	return snap, nil
+}
+
+// List returns all snapshot IDs.
+func (st *SnapshotTree) List() []string {
+	st.mu.Lock()
+	defer st.mu.Unlock()
+	ids := make([]string, 0, len(st.snapshots))
+	for id := range st.snapshots {
+		ids = append(ids, id)
+	}
+	return ids
+}
+
+// Get returns a snapshot by ID.
+func (st *SnapshotTree) Get(id string) (*SnapshotState, bool) {
+	st.mu.Lock()
+	defer st.mu.Unlock()
+	s, ok := st.snapshots[id]
+	return s, ok
+}
+
+// Prune removes a snapshot from the tree.
+func (st *SnapshotTree) Prune(id string) error {
+	st.mu.Lock()
+	defer st.mu.Unlock()
+	if _, ok := st.snapshots[id]; !ok {
+		return fmt.Errorf("snapshot %q not found", id)
+	}
+	delete(st.snapshots, id)
+	return nil
+}
