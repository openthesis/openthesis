+//       t.Kernel().DeterministicRNG().Read(b[:])
+//       isn = seqnum.Value(binary.LittleEndian.Uint32(b[:]))
+//   }
+//
+// Port allocation: Replace random port selection with sequential allocation
+// from a seed-derived base to ensure reproducibility.
