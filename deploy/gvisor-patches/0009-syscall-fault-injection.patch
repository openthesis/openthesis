+package kernel
+
+import (
+	"encoding/binary"
+	"math"
+	"sync"
+)
+
+// SyscallFault describes a fault to inject for a specific syscall.
+// Faults are matched by (TID, Sysno) and fire based on Count and
+// Probability. They are configured via the control socket.
+type SyscallFault struct {
+	// TID is the target task's thread ID. 0 means match all tasks.
+	TID int32 `json:"tid"`
+
+	// Sysno is the syscall number to fault. -1 means match all syscalls.
+	Sysno int64 `json:"sysno"`
+
+	// Errno is the error number to return (e.g., 5 for EIO).
+	Errno int32 `json:"errno"`
+
+	// Count is the remaining number of times to inject this fault.
+	// -1 means infinite (inject every matching call).
+	Count int32 `json:"count"`
+
+	// Probability is the chance [0.0, 1.0] of injecting per invocation.
+	// 1.0 means always inject. Values < 1.0 use the deterministic RNG
+	// for the coin flip, ensuring reproducibility.
+	Probability float64 `json:"probability"`
+}
+
+// SyscallFaultTable manages active syscall faults. It is consulted on
+// every syscall dispatch in DST mode. Faults are added via the control
+// socket and automatically removed when their count reaches zero.
+type SyscallFaultTable struct {
+	mu     sync.Mutex
+	faults []SyscallFault
+	rng    *DeterministicRNG
+}
+
+// NewSyscallFaultTable creates a fault table using the given RNG for
+// probabilistic fault decisions.
+func NewSyscallFaultTable(rng *DeterministicRNG) *SyscallFaultTable {
+	return &SyscallFaultTable{
+		rng: rng,
+	}
+}
+
+// Add adds a new syscall fault rule. Multiple faults can be active
+// simultaneously; they are checked in FIFO order.
+func (sft *SyscallFaultTable) Add(fault SyscallFault) {
+	sft.mu.Lock()
+	defer sft.mu.Unlock()
+	sft.faults = append(sft.faults, fault)
+}
+
+// Check tests whether the given syscall should be faulted.
+// Returns (errno, true) if the syscall should fail with the given errno,
+// or (0, false) if the syscall should proceed normally.
+//
+// Matching rules:
+//  1. TID: fault.TID == 0 matches all tasks; otherwise must match exactly.
+//  2. Sysno: fault.Sysno == -1 matches all syscalls; otherwise must match.
+//  3. Count: 0 means exhausted (skip); -1 means infinite; >0 means decrement.
+//  4. Probability: roll the deterministic RNG; inject only if roll < prob.
+func (sft *SyscallFaultTable) Check(tid int32, sysno uintptr) (int32, bool) {
+	sft.mu.Lock()
+	defer sft.mu.Unlock()
+
+	for i := 0; i < len(sft.faults); i++ {
+		f := &sft.faults[i]
+
+		// Match TID (0 = wildcard).
+		if f.TID != 0 && f.TID != tid {
+			continue
+		}
+
+		// Match sysno (-1 = wildcard).
+		if f.Sysno >= 0 && f.Sysno != int64(sysno) {
+			continue
+		}
+
+		// Check remaining count.
+		if f.Count == 0 {
+			continue
+		}
+
+		// Check probability using deterministic RNG.
+		if f.Probability < 1.0 && sft.rng != nil {
+			var b [8]byte
+			sft.rng.Read(b[:])
+			r := float64(binary.LittleEndian.Uint64(b[:])) / float64(math.MaxUint64)
+			if r >= f.Probability {
+				continue
+			}
+		}
+
+		// Inject the fault.
+		errno := f.Errno
+
+		if f.Count > 0 {
+			f.Count--
+		}
+
+		// Remove exhausted faults.
+		if f.Count == 0 {
+			sft.faults = append(sft.faults[:i], sft.faults[i+1:]...)
+		}
+
+		return errno, true
+	}
+
+	return 0, false
+}
+
+// Clear removes all active faults.
+func (sft *SyscallFaultTable) Clear() {
+	sft.mu.Lock()
+	defer sft.mu.Unlock()
+	sft.faults = sft.faults[:0]
+}
+
+// FaultCount returns the number of active fault rules.
+func (sft *SyscallFaultTable) FaultCount() int {
+	sft.mu.Lock()
+	defer sft.mu.Unlock()
+	return len(sft.faults)
+}
+
+// List returns a copy of the active fault rules.
+func (sft *SyscallFaultTable) List() []SyscallFault {
+	sft.mu.Lock()
+	defer sft.mu.Unlock()
+	out := make([]SyscallFault, len(sft.faults))
+	copy(out, sft.faults)
+	return out
+}
diff --git a/pkg/sentry/kernel/task_syscall.go b/pkg/sentry/kernel/task_syscall.go
index 4cd84ea9d..4e7847b4c 100644
--- a/pkg/sentry/kernel/task_syscall.go
+++ b/pkg/sentry/kernel/task_syscall.go
@@ -82,6 +82,17 @@ func (t *Task) invokeExternal() {
 }
 
 func (t *Task) executeSyscall(sysno uintptr, args arch.SyscallArguments) (rval uintptr, ctrl *SyscallControl, err error) {
+	// NOTE(openthesis): In DST mode, check for injected syscall faults
+	// before running the real syscall handler. Faulted syscalls have
+	// zero side effects — this accurately simulates kernel-level errors.
+	if t.k.DeterministicMode() {
+		if sft := t.k.SyscallFaultTable(); sft != nil {
+			if errno, faulted := sft.Check(int32(t.ThreadID()), sysno); faulted {
+				return 0, nil, linuxerr.ErrorFromUnix(unix.Errno(errno))
+			}
+		}
+	}
+
 	s := t.SyscallTable()
 
 	fe := s.FeatureEnable.Word(sysno)
-- 
