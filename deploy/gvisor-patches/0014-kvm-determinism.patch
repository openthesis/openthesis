+
+// DSTClocker is optionally implemented by platforms that support DST virtual
+// time injection. When implemented, SetDSTGetTimeNS registers a callback used
+// to synchronise the guest's time source (e.g. TSC offset in KVM) with the
+// sentry's virtual clock before each vCPU quantum.
+type DSTClocker interface {
+	SetDSTGetTimeNS(fn func() int64)
+}
