+++ b/pkg/sentry/platform/kvm/kvm.go
@@ -242,3 +242,9 @@ func (*constructor) Requirements() platform.Requirements {
 func init() {
 	platform.Register("kvm", &constructor{})
 }
+
+// SetDSTGetTimeNS implements platform.DSTClocker. fn is called before each
+// vCPU quantum to synchronise the guest TSC with the virtual clock.
+func (k *KVM) SetDSTGetTimeNS(fn func() int64) {
+	k.machine.dstGetTimeNS = fn
+}
