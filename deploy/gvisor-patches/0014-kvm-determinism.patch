+// setTSCToVirtual sets the vCPU TSC so that guest RDTSC returns virtual time.
+// virtualNS is the current virtual monotonic time in nanoseconds.
+//
+//go:nosplit
+func (c *vCPU) setTSCToVirtual(virtualNS int64) {
+	freq := c.machine.tscFreqKHz
+	if freq == 0 || virtualNS <= 0 {
+		return
+	}
+	// TSC ticks = virtualNS_ns * freqKHz / 1_000_000
+	// because freqKHz * 1000 Hz/kHz * 1ns/1e9s = freqKHz/1e6 ticks/ns
+	virtualTSC := uint64(virtualNS) * freq / 1_000_000
+	_ = c.setTSC(virtualTSC)
+}
