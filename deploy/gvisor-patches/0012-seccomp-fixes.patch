diff --git a/pkg/sentry/kernel/dst_coverage.go b/pkg/sentry/kernel/dst_coverage.go
index d2fbd2bc0..437201fe6 100644
--- a/pkg/sentry/kernel/dst_coverage.go
+++ b/pkg/sentry/kernel/dst_coverage.go
@@ -27,33 +27,16 @@ const (
 // CoverageBitmap provides shared-memory code coverage collection using
 // an AFL-style edge coverage bitmap. The bitmap is backed by a memfd
 // so the host process can read it directly via mmap without any IPC.
-//
-// Edge coverage tracks transitions between basic blocks (PC pairs),
-// not just which blocks were visited. This provides better sensitivity
-// for the explorer's coverage-guided state space search.
 type CoverageBitmap struct {
 	mu sync.Mutex
-
-	// fd is the memfd file descriptor.
 	fd int
-
-	// bitmap is the mmap'd coverage bitmap.
 	bitmap []byte
-
-	// size is the bitmap size in bytes.
 	size int
-
-	// prevPC tracks the previous PC for edge coverage.
-	// Edge hash = current_PC XOR (prevPC >> 1).
 	prevPC uint64
-
-	// totalEdges is the number of unique edges recorded since last reset.
 	totalEdges int
 }
 
 // NewCoverageBitmap creates a new coverage bitmap backed by a memfd.
-// The memfd is created with MFD_CLOEXEC cleared so it can be passed
-// to the host via /proc/self/fd/N.
 func NewCoverageBitmap(size int) (*CoverageBitmap, error) {
 	if size <= 0 {
 		size = DefaultCoverageBitmapSize
@@ -69,10 +52,7 @@ func NewCoverageBitmap(size int) (*CoverageBitmap, error) {
 		return nil, fmt.Errorf("ftruncate coverage memfd to %d: %w", size, err)
 	}
 
-	bitmap, err := unix.Mmap(fd, 0, size,
-		unix.PROT_READ|unix.PROT_WRITE,
-		unix.MAP_SHARED,
-	)
+	bitmap, err := unix.Mmap(fd, 0, size, unix.PROT_READ|unix.PROT_WRITE, unix.MAP_SHARED)
 	if err != nil {
 		unix.Close(fd)
 		return nil, fmt.Errorf("mmap coverage memfd: %w", err)
@@ -85,14 +65,10 @@ func NewCoverageBitmap(size int) (*CoverageBitmap, error) {
 	}, nil
 }
 
-// RecordEdge records a control flow edge from the previous PC to the
-// current PC. Uses AFL-style hashing: hash = (pc ^ (prevPC >> 1)).
-//
-// This is called from the syscall dispatch path (task_syscall.go) after
-// each syscall handler returns. The PC is typically obtained from
-// runtime.Callers or from the task's register state.
+// RecordEdge records a control flow edge from the previous PC to pc.
 func (cb *CoverageBitmap) RecordEdge(pc uint64) {
 	cb.mu.Lock()
+	defer cb.mu.Unlock()
 
 	hash := (pc ^ (cb.prevPC >> 1)) % uint64(cb.size*8)
 	byteIdx := hash / 8
@@ -105,12 +81,9 @@ func (cb *CoverageBitmap) RecordEdge(pc uint64) {
 	}
 
 	cb.prevPC = pc
-
-	cb.mu.Unlock()
 }
 
 // FD returns the memfd file descriptor for sharing with the host.
-// The host can mmap this fd to read coverage data directly.
 func (cb *CoverageBitmap) FD() int {
 	return cb.fd
 }
@@ -120,8 +93,7 @@ func (cb *CoverageBitmap) Size() int {
 	return cb.size
 }
 
-// Count returns the number of unique edges seen since last reset.
-// This scans the bitmap, which is O(size) but accurate.
+// Count returns the number of set bits in the bitmap.
 func (cb *CoverageBitmap) Count() int {
 	cb.mu.Lock()
 	defer cb.mu.Unlock()
@@ -133,8 +105,7 @@ func (cb *CoverageBitmap) Count() int {
 	return count
 }
 
-// Reset clears the bitmap and resets the edge counter.
-// Called between exploration episodes.
+// Reset clears bitmap state for a new exploration episode.
 func (cb *CoverageBitmap) Reset() {
 	cb.mu.Lock()
 	defer cb.mu.Unlock()
@@ -146,5 +117,18 @@ func (cb *CoverageBitmap) Reset() {
 	cb.totalEdges = 0
 }
 
-// Close unmaps the bitmap and closes the memfd.
+// Close unmaps and closes the backing memfd.
 func (cb *CoverageBitmap) Close() error {
+	cb.mu.Lock()
+	defer cb.mu.Unlock()
+
+	if cb.bitmap != nil {
+		unix.Munmap(cb.bitmap)
+		cb.bitmap = nil
+	}
+	if cb.fd >= 0 {
+		unix.Close(cb.fd)
+		cb.fd = -1
+	}
+	return nil
+}
diff --git a/pkg/sentry/kernel/dst_scheduler.go b/pkg/sentry/kernel/dst_scheduler.go
index 3a1bb7d66..77ff92304 100644
--- a/pkg/sentry/kernel/dst_scheduler.go
+++ b/pkg/sentry/kernel/dst_scheduler.go
@@ -17,6 +17,7 @@ package kernel
 import (
 	"container/heap"
 	"sync"
+	"time"
 
 	sentryTime "gvisor.dev/gvisor/pkg/sentry/time"
 )
@@ -90,7 +91,16 @@ func (ds *DeterministicScheduler) Schedule() {
 		ds.mu.Lock()
 		for (ds.runnable.Len() == 0 || ds.paused) && !ds.stopped {
 			ds.mu.Unlock()
-			<-ds.wakeup
+			// When idle, advance the virtual clock periodically so that
+			// sleeping tasks can wake up via timer callbacks. AdvanceQuantum
+			// is a no-op when the clock is frozen (during checkpoint).
+			select {
+			case <-ds.wakeup:
+				// A task became runnable or state changed.
+			case <-time.After(10 * time.Millisecond):
+				// Advance virtual clock to fire pending sleep timers.
+				ds.clock.AdvanceQuantum()
+			}
 			ds.mu.Lock()
 		}
 
@@ -172,8 +182,10 @@ func (ds *DeterministicScheduler) TaskCount() int {
 // taskYielded is called by Task.yield() to notify the scheduler that
 // the task has reached a yield point and is returning control.
 func (ds *DeterministicScheduler) taskYielded(t *Task) {
-	// Signal the scheduler that this task has yielded.
-	t.deterministicYield <- struct{}{}
+	// Guard: skip if channel not initialized (task not DST-registered).
+	if t.deterministicYield != nil {
+		t.deterministicYield <- struct{}{}
+	}
 }
 
 // notify sends a non-blocking signal to the wakeup channel.
diff --git a/pkg/sentry/kernel/task_run.go b/pkg/sentry/kernel/task_run.go
index 00be3b14a..1fe12a4a5 100644
--- a/pkg/sentry/kernel/task_run.go
+++ b/pkg/sentry/kernel/task_run.go
@@ -406,7 +406,9 @@ func (t *Task) Yield() {
 // goroutine blocks on deterministicResume until the scheduler picks
 // it again based on TID ordering.
 func (t *Task) dstYield() {
-	if t.k.DeterministicScheduler() != nil {
+	if t.k.DeterministicScheduler() != nil &&
+		t.deterministicResume != nil &&
+		t.deterministicYield != nil {
 		t.k.DeterministicScheduler().taskYielded(t)
 		<-t.deterministicResume
 	}
