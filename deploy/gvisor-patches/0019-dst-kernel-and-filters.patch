+// Reseed resets the RNG to a new initial seed. Call this before forking a
+// guest process to ensure the child explores a different random path.
+func (r *DeterministicRNG) Reseed(seed uint64) {
+	r.mu.Lock()
+	r.seed = seed
+	// Re-expand seed to 256 bits using SplitMix64 (same as NewDeterministicRNG).
+	s := seed
+	for i := 0; i < 4; i++ {
+		s += 0x9e3779b97f4a7c15
+		s = (s ^ (s >> 30)) * 0xbf58476d1ce4e5b9
+		s = (s ^ (s >> 27)) * 0x94d049bb133111eb
+		r.state[i] = s ^ (s >> 31)
+	}
+	r.counter = 0
+	r.mu.Unlock()
+}
