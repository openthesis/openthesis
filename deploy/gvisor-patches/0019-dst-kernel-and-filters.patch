+// TaskBlocking is called when the current task is about to enter a blocking
+// wait (e.g., waiting for I/O or a futex). The scheduler marks the task as
+// blocking so it won't be re-queued after the current quantum ends.
+// MakeRunnable() will re-add the task when the blocking event fires.
+func (ds *DeterministicScheduler) TaskBlocking(t *Task) {
+	ds.mu.Lock()
+	defer ds.mu.Unlock()
+	if ds.current == t {
+		ds.currentBlocking = true
+	}
+}
