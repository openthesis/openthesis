diff --git a/runsc/dst/ctrl.go b/runsc/dst/ctrl.go
index ff722bab5..1d937d8a2 100644
--- a/runsc/dst/ctrl.go
+++ b/runsc/dst/ctrl.go
@@ -21,6 +21,7 @@ import (
 	"encoding/json"
 	"fmt"
 	"net"
+	"time"
 	"os"
 	"path/filepath"
 
@@ -236,4 +237,69 @@ func (cs *ControlServer) dispatch(req controlRequest) controlResponse {
 		}
 
 	case "set-time":
+		nanos := req.Nanos
+		if nanos == 0 {
+			nanos = req.NS
+		}
+		if vc, ok := cs.kernel.VirtualClock().(sentryTime.MutableClock); ok {
+			vc.SetTime(sentryTime.Monotonic, nanos)
+			return controlResponse{OK: true, VirtualTimeNS: nanos}
+		}
+		return controlResponse{OK: false, Error: "virtual clock not initialized"}
+
+	case "set-seed":
+		if rng := cs.kernel.DeterministicRNG(); rng != nil {
+			rng.Reseed(req.Seed)
+			return controlResponse{OK: true, RNGSeed: req.Seed}
+		}
+		return controlResponse{OK: false, Error: "deterministic RNG not initialized"}
+
+	case "advance-time":
+		if vc, ok := cs.kernel.VirtualClock().(sentryTime.MutableClock); ok {
+			cur, _ := vc.GetTime(sentryTime.Monotonic)
+			newTime := cur + int64(req.DeltaNS)
+			vc.SetTime(sentryTime.Monotonic, newTime)
+			return controlResponse{OK: true, VirtualTimeNS: newTime}
+		}
+		return controlResponse{OK: false, Error: "virtual clock not initialized"}
+
+	case "run-burst":
+		sched := cs.kernel.DeterministicScheduler()
+		if sched == nil {
+			return controlResponse{OK: false, Error: "deterministic scheduler not initialized"}
+		}
+		insns := req.Instructions
+		if insns == 0 {
+			insns = 5000000
+		}
+		totalNS := insns * 128
+		sched.Resume()
+		// Give ptraced tasks real wall-clock time to make progress.
+		// The DeterministicScheduler does not yet use task channels for ptrace threads,
+		// so we sleep proportionally to virtual time (1ms per 10ms virtual, min 50ms).
+		wallNS := totalNS / 10
+		if wallNS < 50_000_000 {
+			wallNS = 50_000_000
+		}
+		time.Sleep(time.Duration(wallNS))
+		quantumNS := uint64(10000000)
+		for remaining := totalNS; remaining > 0; {
+			step := quantumNS
+			if remaining < step {
+				step = remaining
+			}
+			sched.AdvanceQuantum(step)
+			remaining -= step
+		}
+		sched.Pause()
+		var vt int64
+		if vc := cs.kernel.VirtualClock(); vc != nil {
+			vt, _ = vc.GetTime(sentryTime.Monotonic)
+		}
+		return controlResponse{OK: true, VirtualTimeNS: vt}
+
+	default:
+		return controlResponse{OK: false, Error: fmt.Sprintf("unknown command: %s", req.Cmd)}
+	}
+}
