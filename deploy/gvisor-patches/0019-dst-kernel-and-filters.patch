+// AdvanceQuantum advances the virtual clock by stepNS nanoseconds and
+// signals the scheduler loop. Called by the DST control socket during
+// run-burst to drive time forward in fixed increments.
+func (ds *DeterministicScheduler) AdvanceQuantum(stepNS uint64) {
+	ds.mu.Lock()
+	clk := ds.clock
+	ds.mu.Unlock()
+	if clk != nil {
+		clk.AdvanceInstructions(stepNS) // reuse: 1 ns per "instruction" at 1 GHz
+	}
+	ds.notify()
+}
