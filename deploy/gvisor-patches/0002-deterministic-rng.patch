+package kernel
+
+import (
+	"encoding/binary"
+	"sync"
+)
+
+// DeterministicRNG provides reproducible randomness for the entire sandbox.
+// It uses a ChaCha20-inspired counter-mode PRNG seeded from the simulation seed.
+// The state is safe to checkpoint/restore — subsequent calls produce the same stream.
+type DeterministicRNG struct {
+	mu      sync.Mutex
+	seed    uint64    // original seed (stored for checkpoint/restore metadata)
+	state   [4]uint64 // SplitMix64-derived internal state
+	counter uint64
+}
+
+// NewDeterministicRNG creates a new PRNG from a 64-bit simulation seed.
+// The seed is expanded into internal state via SplitMix64.
+func NewDeterministicRNG(seed uint64) *DeterministicRNG {
+	r := &DeterministicRNG{seed: seed}
+	// Expand seed to 256 bits using SplitMix64.
+	s := seed
+	for i := 0; i < 4; i++ {
+		s += 0x9e3779b97f4a7c15
+		s = (s ^ (s >> 30)) * 0xbf58476d1ce4e5b9
+		s = (s ^ (s >> 27)) * 0x94d049bb133111eb
+		r.state[i] = s ^ (s >> 31)
+	}
+	return r
+}
+
+// Seed returns the original seed used to initialize this RNG.
+// Used by the snapshot mechanism to record the deterministic parameters.
+func (r *DeterministicRNG) Seed() uint64 {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.seed
+}
+
+// next returns the next 64-bit pseudo-random value using xorshift128+.
+// Must be called with r.mu held.
+func (r *DeterministicRNG) next() uint64 {
+	s0 := r.state[0]
+	s1 := r.state[1]
+	result := s0 + s1
+
+	s1 ^= s0
+	r.state[0] = ((s0 << 55) | (s0 >> 9)) ^ s1 ^ (s1 << 14)
+	r.state[1] = (s1 << 36) | (s1 >> 28)
+	r.counter++
+	return result
+}
+
+// Read implements io.Reader. Fills b with deterministic pseudo-random bytes.
+func (r *DeterministicRNG) Read(b []byte) (int, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+
+	n := 0
+	for n < len(b) {
+		v := r.next()
+		var buf [8]byte
+		binary.LittleEndian.PutUint64(buf[:], v)
+		copied := copy(b[n:], buf[:])
+		n += copied
+	}
+	return n, nil
+}
