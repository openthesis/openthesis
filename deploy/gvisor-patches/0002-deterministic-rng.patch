diff --git a/pkg/sentry/syscalls/linux/sys_random.go b/pkg/sentry/syscalls/linux/sys_random.go
index fed7930d2..84349b3e8 100644
--- a/pkg/sentry/syscalls/linux/sys_random.go
+++ b/pkg/sentry/syscalls/linux/sys_random.go
@@ -31,6 +31,19 @@ const (
 	_GRND_RANDOM   = 0x2
 )
 
+// getrandomDST is the DST-mode implementation of getrandom(2).
+// It reads from the kernel's deterministic PRNG instead of host entropy.
+func getrandomDST(t *kernel.Task, sysno uintptr, args arch.SyscallArguments) (uintptr, *kernel.SyscallControl, error) {
+	buf := args[0].Pointer()
+	length := args[1].SizeT()
+
+	b := make([]byte, length)
+	t.Kernel().DeterministicRNG().Read(b)
+
+	n, err := t.CopyOutBytes(buf, b)
+	return uintptr(n), nil, err
+}
+
 // GetRandom implements the linux syscall getrandom(2).
 //
 // In a multi-tenant/shared environment, the only valid implementation is to
@@ -39,6 +52,9 @@ const (
 // the GRND_RANDOM flag is ignored. The GRND_NONBLOCK flag does not apply, as
 // the pool will already be initialized.
 func GetRandom(t *kernel.Task, sysno uintptr, args arch.SyscallArguments) (uintptr, *kernel.SyscallControl, error) {
+	if t.Kernel().DeterministicMode() {
+		return getrandomDST(t, sysno, args)
+	}
