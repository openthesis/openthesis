 create mode 100644 pkg/sentry/kernel/dst_rng.go

diff --git a/pkg/rand/rand_linux.go b/pkg/rand/rand_linux.go
index 0913e8b00..45e50732c 100644
--- a/pkg/rand/rand_linux.go
+++ b/pkg/rand/rand_linux.go
@@ -65,11 +65,36 @@ func (b *bufferedReader) Read(p []byte) (int, error) {
 	return io.ReadAtLeast(b.r, p, min)
 }
 
+// dstMu protects dstReader.
+var dstMu sync.Mutex
+
+// dstReader is the deterministic reader set in DST mode. When non-nil,
+// all calls to Read() use this instead of crypto/rand.
+var dstReader io.Reader
+
+// SetDeterministicSource replaces the package-level random reader with
+// the given deterministic source. Pass nil to restore host entropy.
+//
+// NOTE(openthesis): Call this from kernel initialization when DST mode
+// is enabled. This affects ALL Sentry-internal rand.Read() calls.
+func SetDeterministicSource(r io.Reader) {
+	dstMu.Lock()
+	defer dstMu.Unlock()
+	dstReader = r
+}
+
 // Reader is the default reader.
 var Reader io.Reader = &bufferedReader{r: bufio.NewReader(&reader{})}
 
-// Read reads from the default reader.
+// Read reads from the current reader. In DST mode, reads from the
+// deterministic PRNG; otherwise reads from crypto/rand.
 func Read(b []byte) (int, error) {
+	dstMu.Lock()
+	dr := dstReader
+	dstMu.Unlock()
+	if dr != nil {
+		return io.ReadFull(dr, b)
+	}
 	return io.ReadFull(Reader, b)
 }
 
